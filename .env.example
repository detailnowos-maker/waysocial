# --- Supabase (deixe em branco para rodar 100% com dados de demonstração locais) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Mapa ---
# demo   = mapa ilustrativo offline (padrão, sem chave)
# tiles  = mapa raster em tiles XYZ (Mapbox, MapTiler, servidor próprio...)
EXPO_PUBLIC_MAP_PROVIDER=demo
# Exemplo (troque pelo seu provedor e respeite os termos de uso dele):
# EXPO_PUBLIC_MAP_TILE_URL=https://SEU_SERVIDOR/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=

# --- IA (opcional) ---
# Endpoint HTTP seu (ex.: Supabase Edge Function) que implementa o contrato de docs/AI.md.
# Em branco = IA simulada por templates.
EXPO_PUBLIC_AI_ENDPOINT=
